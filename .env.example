# Copy to .env and fill in for local development.
# On Render, set these as environment variables in the dashboard instead.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Postgres connection string; leave unset locally to use sqlite.
# DATABASE_URL=postgres://user:password@host:5432/dbname

TIME_ZONE=UTC

# Google Calendar (see bookings/services/google_calendar.py for setup steps)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Email (optional, defaults to printing emails to the console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com
